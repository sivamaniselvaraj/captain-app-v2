<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain http to the desktop on the local network.
     Tighten this before a release build. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
